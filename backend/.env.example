# Hephaestus backend environment (SUBTASK 1.3).
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Required before the assistant can make AI calls ---
# Base URL of the internal office AI API.
HEPHAESTUS_AI_ENDPOINT=https://ai.internal.example.com/v1
# API key for the internal AI API. Read by name from config/default.yaml (ai.api_key_env).
HEPHAESTUS_AI_API_KEY=replace-me

# --- Optional ---
# Override the config file the backend loads (defaults to config/default.yaml).
# HEPHAESTUS_CONFIG=config/default.yaml
